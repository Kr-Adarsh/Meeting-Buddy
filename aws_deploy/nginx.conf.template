server {
    listen 80;
    server_name meetingbuddy.duckdns.org;

    # Root web server pointing to our Vite React Build
    root /home/ubuntu/Meeting-Buddy/frontend/dist;
    index index.html index.htm;

    # Removed network-level Basic Auth directly in favor of Application-level Google OAuth
    # React DOM Router
    location / {
        try_files $uri /index.html;
    }

    # Proxy all internal backend logic exclusively to Python Port 8000
    location /jobs {
        proxy_pass http://127.0.0.1:8000/jobs;
        proxy_set_header Host $host;
    }
    
    location /job-status/ {
        proxy_pass http://127.0.0.1:8000/job-status/;
        proxy_set_header Host $host;
    }

    location /deploy-bot {
        proxy_pass http://127.0.0.1:8000/deploy-bot;
        proxy_set_header Host $host;
    }

    location /stop-bot/ {
        proxy_pass http://127.0.0.1:8000/stop-bot/;
        proxy_set_header Host $host;
    }
    
    location /debug_screenshots/ {
        proxy_pass http://127.0.0.1:8000/debug_screenshots/;
        proxy_set_header Host $host;
    }
    
    location /summarize/ {
        proxy_pass http://127.0.0.1:8000/summarize/;
        proxy_set_header Host $host;
    }
    
    location /download/ {
        proxy_pass http://127.0.0.1:8000/download/;
        proxy_set_header Host $host;
    }
}
