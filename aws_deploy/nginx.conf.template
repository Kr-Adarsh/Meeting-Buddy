server {
    listen 80;
    server_name _;

    # Root web server pointing to our Vite React Build
    root /home/ubuntu/MeetingBuddy/frontend/dist;
    index index.html index.htm;

    # Protect the entire domain natively via Basic Auth
    auth_basic "Restricted Access - Meeting Buddy Admin Only";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # React DOM Router
    location / {
        try_files $uri /index.html;
    }

    # Proxy all internal backend logic exclusively to Python Port 8000
    location /jobs {
        proxy_pass http://127.0.0.1:8000/jobs;
        proxy_set_header Host $host;
    }
    
    location /job-status/ {
        proxy_pass http://127.0.0.1:8000/job-status/;
        proxy_set_header Host $host;
    }

    location /deploy {
        proxy_pass http://127.0.0.1:8000/deploy;
        proxy_set_header Host $host;
    }

    location /stop-bot/ {
        proxy_pass http://127.0.0.1:8000/stop-bot/;
        proxy_set_header Host $host;
    }
    
    location /summarize/ {
        proxy_pass http://127.0.0.1:8000/summarize/;
        proxy_set_header Host $host;
    }
    
    location /download/ {
        proxy_pass http://127.0.0.1:8000/download/;
        proxy_set_header Host $host;
    }
}
